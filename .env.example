# UNTUK PENGEMBANGAN DI LAPTOP.
# Untuk server VPS, pakai .env.production.example — di sana sandi database
# diisi lewat POSTGRES_PASSWORD, bukan DATABASE_URL.

# Sandi database lokal ada di dalam URL ini: user "pbk", sandi "pbk", port 5433.
DATABASE_URL="postgresql://pbk:pbk@localhost:5433/pbk?schema=public"
AUTH_SECRET="ganti-dengan-hasil-node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
AUTH_TRUST_HOST=true

ENCRYPTION_KEY="hasil-dari-openssl-rand-base64-32"
SEED_ADMIN_PASSWORD="sandi-awal-akun-admin"

# WA Gateway (opsional) — alamat dasar tanpa /send-message; WA_INSTANCE mis. "wa2",
# kosong = instance pertama yang terhubung. Penjelasan lengkap di .env.production.example.
WA_BASE_URL="http://localhost:3000"
WA_API_KEY="wag_ganti-dengan-kunci-dari-dashboard-gateway"
WA_INSTANCE=""
