# =============================================================================
#  PBK — konfigurasi SERVER VPS (dipakai docker-compose.prod.yml)
#
#  Salin menjadi .env di folder aplikasi di server:
#      cp .env.production.example .env
#  Untuk pengembangan di laptop, pakai .env.example.
#
#  Isi SEMUA nilai sebelum `docker compose up` yang pertama.
# =============================================================================


# --- Domain & HTTPS ----------------------------------------------------------

# Nama domain aplikasi, persis seperti di DNS. Caddy hanya melayani nama ini.
DOMAIN=pbk.sekolahanda.sch.id

# Cara HTTPS diurus:
#   (kosong)            DNS domain mengarah langsung ke IP server; Caddy
#                       mengambil sertifikat Let's Encrypt sendiri.
#   Caddyfile.tunnel    Memakai Cloudflare Tunnel. Arahkan service tunnel ke
#                       HTTP → localhost:80 (bukan https://IP:443, itu 502).
CADDYFILE=


# --- Database ----------------------------------------------------------------

# Sandi database. DATABASE_URL tidak perlu diisi — Docker Compose merakitnya
# dari nilai ini.
#   - Pakai HANYA huruf dan angka: sandi ini ditempel ke dalam URL koneksi,
#     jadi karakter @ / : # ? % akan merusaknya.
#   - Postgres hanya memakai nilai ini saat database PERTAMA kali dibuat.
#     Mengubahnya belakangan tidak mengganti sandi database yang sudah ada.
# Hasilkan:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=ganti-dengan-sandi-acak-panjang


# --- Keamanan aplikasi -------------------------------------------------------

# Kunci penanda tangan sesi login. Menggantinya membuat semua pengguna logout.
# Hasilkan:  openssl rand -base64 32
AUTH_SECRET=hasil-dari-openssl-rand-base64-32

# Kunci enkripsi secret 2FA pengguna. Harus tepat 32 byte dalam base64 —
# kalimat buatan sendiri akan ditolak.
# JANGAN PERNAH diganti atau hilang setelah ada pengguna mendaftar 2FA:
# tanpa kunci yang sama, semua 2FA tidak bisa dibaca dan harus direset.
# Simpan salinannya di tempat aman, terpisah dari backup database.
# Hasilkan:  openssl rand -base64 32
ENCRYPTION_KEY=hasil-dari-openssl-rand-base64-32

# Sandi login pertama akun `admin`. Hanya dipakai saat seed pertama kali;
# setelah itu ganti lewat aplikasi.
SEED_ADMIN_PASSWORD=sandi-acak-panjang-untuk-login-pertama


# --- WhatsApp Gateway (kode OTP login & lupa sandi) --------------------------
# Opsional. Kosongkan bila tidak punya gateway — pengguna tetap bisa memakai
# Google Authenticator.

# Alamat dasar gateway, TANPA /send-message (aplikasi yang menambahkannya).
# Aplikasi berjalan di dalam container, jadi `localhost` di sini berarti
# container itu sendiri — pakai IP server, domain gateway, atau nama service
# Docker bila satu jaringan.
WA_BASE_URL=http://alamat-gateway-anda:3000

# API key dari dashboard gateway (Settings → API Keys). Dikirim sebagai
# header  Authorization: Bearer <key>
WA_API_KEY=wag_kunci-dari-dashboard-gateway

# Instance pengirim, mis. wa2. Kosongkan untuk memakai instance pertama yang
# terhubung. Penerima selalu nomor pribadi pengguna (628…), bukan alias grup.
WA_INSTANCE=
