# dependencies
node_modules/

# build output
.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# secrets — ignore every env file, then re-allow only the templates.
# Enumerating names (.env, .env.local) left .env.production, .env.vps and
# similar unprotected, which matters because DEPLOYMENT.md has you copy from
# a file literally named .env.production.example.
.env*
!.env.example
!.env.production.example

# local development database (portable PostgreSQL, ~1.4 GB — test tooling only)
.postgres/
.pgdata/

# agent scratch workspace
.superpowers/

# test output
test-results/
playwright-report/
blob-report/
playwright/.cache/
/coverage

# build caches
.turbo/
.swc/
*.log

# design export artifacts
design/.thumbnail

# Boilerplate create-next-app yang tidak dirujuk satu berkas pun. Didaftarkan
# di sini, bukan sekadar dihapus, supaya `git add -A` berikutnya tidak
# memasukkannya kembali — berkasnya masih ada di disk.
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg

# Ekspor desain mandiri 607 KB dari commit b5d8023, memakai merek PBK yang
